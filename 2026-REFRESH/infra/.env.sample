# =============================================================================
# Azure AI Red Teaming Labs - Environment Configuration
# =============================================================================
# Copy this file to .env and fill in your actual values
# Run: cp .env.sample .env
# Or use the setup script: ./infra/2-setup-env.sh
# =============================================================================

# -----------------------------------------------------------------------------
# Azure Subscription & Resource Configuration
# -----------------------------------------------------------------------------
# Your Azure subscription ID (find in Azure Portal > Subscriptions)
AZURE_SUBSCRIPTION_ID=your-subscription-id-here

# Resource group containing your Foundry project
AZURE_RESOURCE_GROUP=your-resource-group-name

# Azure region (recommended: eastus, westus, westeurope, swedencentral for red teaming)
AZURE_LOCATION=eastus

# -----------------------------------------------------------------------------
# Azure AI Foundry Project Configuration
# -----------------------------------------------------------------------------
# Project name (found in Foundry Portal > Project Overview)
AZURE_AI_PROJECT=your-project-name

# Project endpoint URL - Format: https://<account>.services.ai.azure.com/api/projects/<project-name>
# Find this in Foundry Portal > Project Overview > Endpoint
PROJECT_ENDPOINT=https://your-account.services.ai.azure.com/api/projects/your-project

# Alternative format (some SDKs use this)
AZURE_AI_PROJECT_ENDPOINT=https://your-account.services.ai.azure.com/api/projects/your-project

# AI Service connection name (if using AI Services resource)
AZURE_AI_SERVICE=your-ai-service-name

# -----------------------------------------------------------------------------
# Model & Agent Configuration (Core Labs)
# -----------------------------------------------------------------------------
# Model deployment name (e.g., gpt-4, gpt-4o-mini, gpt-4-turbo)
AZURE_AI_DEPLOYMENT_NAME=gpt-4

# Alternative variable name (used by some notebooks)
AZURE_AI_MODEL_DEPLOYMENT_NAME=gpt-4

# Agent name for red teaming (e.g., my-first-agent, Cora)
AZURE_AI_AGENT_NAME=my-first-agent

# -----------------------------------------------------------------------------
# Azure OpenAI Direct API Configuration (Lab 2 - Model Scanning)
# -----------------------------------------------------------------------------
# Azure OpenAI endpoint - Format: https://<resource-name>.openai.azure.com
MODEL_ENDPOINT=https://your-resource.openai.azure.com
AZURE_OPENAI_ENDPOINT=https://your-resource.openai.azure.com

# Azure OpenAI API key (find in Azure Portal > Your OpenAI Resource > Keys and Endpoint)
MODEL_API_KEY=your-api-key-here
AZURE_OPENAI_API_KEY=your-api-key-here

# Azure OpenAI API version (use latest stable version)
AZURE_OPENAI_API_VERSION=2024-10-01-preview

# Primary model deployment for Lab 2
MODEL_DEPLOYMENT_NAME=gpt-4
AZURE_OPENAI_DEPLOYMENT=gpt-4

# -----------------------------------------------------------------------------
# Optional: Alternative Authentication
# -----------------------------------------------------------------------------
# If using managed identity or service principal, set these:
# AZURE_TENANT_ID=your-tenant-id
# AZURE_CLIENT_ID=your-client-id
# AZURE_CLIENT_SECRET=your-client-secret

# -----------------------------------------------------------------------------
# Lab-Specific Configuration
# -----------------------------------------------------------------------------
# Storage account for evaluation logs (auto-configured in most cases)
# AZURE_STORAGE_ACCOUNT=your-storage-account

# Application Insights connection string (for continuous evaluation - Lab 4)
# AZURE_APPINSIGHTS_CONNECTION_STRING=your-connection-string

# =============================================================================
# NOTES:
# =============================================================================
# 1. Never commit .env files to version control (already in .gitignore)
# 2. For Lab 1 (Agent): Requires PROJECT_ENDPOINT, AZURE_AI_AGENT_NAME
# 3. For Lab 2 (Model): Requires MODEL_ENDPOINT, MODEL_API_KEY, MODEL_DEPLOYMENT_NAME
# 4. For Lab 3 (Cloud): Requires PROJECT_ENDPOINT and Foundry project setup
# 5. Authentication: Uses DefaultAzureCredential (Azure CLI login preferred)
# 6. Run 'az login' before starting labs for authentication
# =============================================================================
